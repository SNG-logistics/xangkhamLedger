<!-- FILE: src/views/periods/detail.ejs -->
<% if (period.status==='LOCKED' ) { %>
    <div class="alert alert-danger">
        <strong>งวดนี้ถูก LOCK แล้ว!</strong> ไม่สามารถแก้ไขข้อมูลได้ กรุณา UNLOCK ก่อน
    </div>
    <% } %>

        <div class="period-detail-header <%= period.status === 'LOCKED' ? 'locked' : '' %>">
            <div class="flex-between">
                <div>
                    <h2>งวดวันที่ <%= new Date(period.period_date).toLocaleDateString('th-TH', { year: 'numeric' ,
                            month: 'long' , day: 'numeric' }) %>
                    </h2>
                    <p>ปี <%= period.period_year %> / เดือน <%= period.period_month %> | ปิดยอดขายงวด 20.00.00 | เวลาออก
                                20:25:00
                    </p>
                </div>
                <div>
                    <span class="status-badge <%= period.status === 'LOCKED' ? 'status-locked' : 'status-open' %>">
                        <%= period.status %>
                    </span>
                </div>
            </div>

            <% const total_prizes=(parseFloat(summary.prize_6_digit) || 0) + (parseFloat(summary.prize_5_digit) || 0) +
                (parseFloat(summary.prize_4_digit) || 0) + (parseFloat(summary.prize_3_digit) || 0) +
                (parseFloat(summary.prize_2_digit) || 0) + (parseFloat(summary.prize_1_digit) || 0); const
                gross_sales=(parseFloat(summary.sales_6_digit) || 0) + (parseFloat(summary.sales_5_digit) || 0) +
                (parseFloat(summary.sales_4_digit) || 0) + (parseFloat(summary.sales_3_digit) || 0) +
                (parseFloat(summary.sales_2_digit) || 0) + (parseFloat(summary.sales_1_digit) || 0); const
                profit_throwing=parseFloat(summary.profit_throwing) || 0; const net_profit=(gross_sales - total_prizes +
                profit_throwing) - (parseFloat(expenseTotal.total_lak) || 0); %>
                <div class="period-info-grid">
                    <div class="period-info-item">
                        <h4>ยอดขาย LAK (Gross)</h4>
                        <p class="money lak">
                            <%= money.format(gross_sales) %>
                        </p>
                    </div>
                    <div class="period-info-item">
                        <h4>ยอดถูกรางวัล (Prizes)</h4>
                        <p class="money thb" style="color: #d35400;">
                            <%= money.format(total_prizes) %>
                        </p>
                    </div>
                    <div class="period-info-item" style="border-left: 5px solid #3498db; background-color: #f0f8ff;">
                        <h4 style="color: #2980b9;">กำไรจากโยนของ</h4>
                        <p class="money lak" style="color: #2980b9;">
                            <%= money.format(profit_throwing) %>
                        </p>
                    </div>
                    <div class="period-info-item">
                        <h4>ค่าใช้จ่าย LAK</h4>
                        <p class="money lak">
                            <%= money.format(expenseTotal.total_lak || 0) %>
                        </p>
                    </div>
                </div>

                <div
                    style="margin-top: 20px; padding: 15px; background: <%= net_profit < 0 ? '#fdeded' : '#eafaf1' %>; border-radius: 8px; border-left: 5px solid <%= net_profit < 0 ? '#e74c3c' : '#2ecc71' %>; text-align: left;">
                    <h4 style="margin: 0; color: <%= net_profit < 0 ? '#c0392b' : '#27ae60' %>; font-size: 1rem;">
                        กำไรสุทธิ (Profit)</h4>
                    <div
                        style="font-size: 1.5rem; font-weight: bold; color: <%= net_profit < 0 ? '#e74c3c' : '#2ecc71' %>; margin: 5px 0;">
                        <%= money.format(net_profit) %>
                    </div>
                    <div
                        style="font-size: 0.85rem; color: <%= net_profit < 0 ? '#c0392b' : '#27ae60' %>; opacity: 0.8;">
                        (Net Sales - Expenses)</div>
                </div>

                <div class="mt-20 flex gap-10">
                    <% if (period.status==='OPEN' ) { %>
                        <button class="btn btn-danger" onclick="lockPeriod(<%= period.id %>)">🔒 LOCK งวด</button>
                        <% } else { %>
                            <button class="btn btn-warning" onclick="unlockPeriod(<%= period.id %>)">🔓 UNLOCK
                                งวด</button>
                            <% } %>
                                <a href="/reports/period/<%= period.id %>" class="btn btn-primary">📊 รายงานงวดนี้</a>
                                <button class="btn btn-warning" onclick="showModal('incidentModal')">⚠️ แจ้งเคส</button>
                </div>

                <!-- Sales Summary -->
                <div class="card">
                    <div class="card-header">
                        <h3>ยอดขาย</h3>
                    </div>
                    <div class="card-body">
                        <% if (period.status==='OPEN' ) { %>
                            <a href="/summaries/<%= period.id %>" class="btn btn-primary">บันทึกยอดขาย</a>
                            <% } else { %>
                                <p><strong>ยอดขาย LAK (Gross):</strong>
                                    <%= money.format(gross_sales) %>
                                </p>
                                <p style="color: #d35400;"><strong>ยอดถูกรางวัล (Prizes):</strong>
                                    <%= money.format(total_prizes) %>
                                </p>
                                <% if (summary.notes) { %>
                                    <p><strong>หมายเหตุ:</strong>
                                        <%= summary.notes %>
                                    </p>
                                    <% } %>
                                        <% if (summary.attached_files) { let files=[]; try {
                                            files=JSON.parse(summary.attached_files); } catch(e) {} if (files.length> 0)
                                            { %>
                                            <div style="margin-top: 10px;">
                                                <strong>หลักฐานแนบ:</strong>
                                                <% files.forEach((file, index)=> { %>
                                                    <a href="/uploads/<%= file %>" target="_blank"
                                                        style="color: #3498db; text-decoration: none; margin-right: 10px;">
                                                        📄 ไฟล์ <%= index + 1 %>
                                                    </a>
                                                    <% }); %>
                                            </div>
                                            <% } } %>
                                                <% } %>
                    </div>
                </div>

                <!-- Expenses -->
                <div class="card mt-20">
                    <div class="card-header">
                        <div class="flex-between">
                            <h3>ค่าใช้จ่าย</h3>
                            <% if (period.status==='OPEN' ) { %>
                                <button class="btn btn-primary" onclick="showQuickExpense()">+
                                    เพิ่มค่าใช้จ่าย (ด่วน)</button>
                                <% } %>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>เวลาเกิด</th>
                                        <th>ประเภท</th>
                                        <th>รายละเอียด</th>
                                        <th>LAK</th>
                                        <th>หลักฐาน</th>
                                        <th>จัดการ</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% expenses.forEach(exp=> { %>
                                        <tr>
                                            <td>
                                                <%= new Date(exp.occurred_at).toLocaleString('th-TH', { year: 'numeric'
                                                    , month: 'short' , day: 'numeric' , hour: '2-digit' ,
                                                    minute: '2-digit' }) %>
                                            </td>
                                            <td>
                                                <%= exp.category %>
                                            </td>
                                            <td>
                                                <%= exp.description %>
                                            </td>
                                            <td class="money lak">
                                                <%= money.format(exp.amount_lak) %>
                                            </td>
                                            <td>
                                                <% if (exp.attached_files) { let files=[]; try {
                                                    files=JSON.parse(exp.attached_files); } catch(e) {} if
                                                    (files.length> 0) {
                                                    %>
                                                    <a href="/uploads/<%= files[0] %>" target="_blank"
                                                        style="color: #3498db; text-decoration: none;">📄 ดูรูป</a>
                                                    <% if(files.length> 1) { %><small style="color: #7f8c8d;">(+<%=
                                                                files.length - 1 %>)</small>
                                                        <% } %>
                                                            <% } else { %>
                                                                <span style="color: #bdc3c7;">-</span>
                                                                <% } } else { %>
                                                                    <span style="color: #bdc3c7;">-</span>
                                                                    <% } %>
                                            </td>
                                            <td>
                                                <% if (period.status==='OPEN' ) { %>
                                                    <button class="btn-icon delete"
                                                        onclick="deleteExpense('<%= exp.id %>', '<%= period.id %>')"
                                                        title="ลบ">
                                                        🗑️
                                                    </button>
                                                    <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>

                        <div class="mt-20">
                            <strong>รวม LAK:</strong> <span class="money lak">
                                <%= money.format(expenseTotal.total_lak) %>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Expense Summary by Category -->
                <div class="card mt-20">
                    <div class="card-header">
                        <h3>สรุปค่าใช้จ่ายแยกประเภท</h3>
                    </div>
                    <div class="card-body">
                        <div class="table-container">
                            <table>
                                <thead>
                                    <tr>
                                        <th>หมวดหมู่</th>
                                        <th class="text-right">รวม LAK</th>
                                    </tr>
                                    <% const categories=[ { name: '1. จ่ายทั่วไป' , key: '1. จ่ายทั่วไป' }, {
                                        name: '2. รวมโปรโมชั่น' , key: '2. รวมโปรโมชั่น' , children: [ {
                                        name: '  2.1 โปรโมชั่นใช้เครดิต' , key: '2.1 โปรโมชั่นใช้เครดิต' }, {
                                        name: '  2.2 โปรโมชั่นเงินสด' , key: '2.2 โปรโมชั่นเงินสด' } ]}, {
                                        name: '3. กิจกรรม/การตลาด' , key: '3. กิจกรรม/การตลาด' }, { name: '4. ธนาคาร' ,
                                        key: '4. ธนาคาร' }, { name: '5. ภาษีอากร' , key: '5. ภาษีอากร' }, {
                                        name: '6. โยนของ' , key: '6. โยนของ' } ]; categories.forEach((cat)=> {
                                        // Use value from controller (already calculated)
                                        const totalForCategory = expenseSummary[cat.key] || 0;
                                        %>
                                        <tr>
                                            <td><strong>
                                                    <%= cat.name %>
                                                </strong></td>
                                            <td class="money lak">
                                                <%= money.format(totalForCategory) %>
                                            </td>
                                        </tr>
                                        <% if (cat.children) { cat.children.forEach(child=> { %>
                                            <tr style="background-color: #f9f9f9;">
                                                <td style="padding-left: 40px;">
                                                    <%= child.name %>
                                                </td>
                                                <td class="money lak">
                                                    <%= money.format(expenseSummary[child.key] || 0) %>
                                                </td>
                                            </tr>
                                            <% }); } %>
                                                <% }) %>
                                                    </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!-- Incidents -->
                <% if (incidents.length> 0) { %>
                    <div class="card mt-20"
                        style="<%= incidents.some(i => i.severity === 'CRITICAL' && i.status === 'OPEN') ? 'border: 2px solid red;' : '' %>">
                        <div class="flex-between">
                            <h3
                                style="<%= incidents.some(i => i.severity === 'CRITICAL' && i.status === 'OPEN') ? 'color: red;' : '' %>">
                                รายการแจ้งเคส/ปัญหา (Incidents)
                            </h3>
                            <!-- Button moved to header -->
                        </div>

                        <div class="table-container mt-10">
                            <table>
                                <thead>
                                    <tr>
                                        <th>ความรุนแรง</th>
                                        <th>หัวข้อ</th>
                                        <th>สถานะ</th>
                                        <th>โดย</th>
                                        <th>การแก้ไข</th>
                                        <th>Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% incidents.forEach(inc=> { %>
                                        <tr
                                            style="<%= inc.status === 'OPEN' && inc.severity === 'CRITICAL' ? 'background: #ffebee;' : '' %>">
                                            <td>
                                                <span
                                                    class="badge badge-<%= inc.severity === 'CRITICAL' ? 'danger' : (inc.severity === 'HIGH' ? 'warning' : 'info') %>">
                                                    <%= inc.severity %>
                                                </span>
                                            </td>
                                            <td>
                                                <strong>
                                                    <%= inc.title %>
                                                </strong><br>
                                                <small>
                                                    <%= inc.description %>
                                                </small>
                                            </td>
                                            <td>
                                                <span
                                                    class="badge badge-<%= inc.status === 'OPEN' ? 'primary' : 'success' %>">
                                                    <%= inc.status %>
                                                </span>
                                            </td>
                                            <td>
                                                <%= inc.creator_name %>
                                            </td>
                                            <td>
                                                <% if (inc.status==='RESOLVED' ) { %>
                                                    <small class="text-success">
                                                        <%= inc.resolution_note %> (by <%= inc.resolver_name %>)
                                                    </small>
                                                    <% } else { %>
                                                        -
                                                        <% } %>
                                            </td>
                                            <td>
                                                <% if (inc.status==='OPEN' ) { %>
                                                    <button class="btn btn-sm btn-success"
                                                        onclick="openResolveModal('<%= inc.id %>')">ปิดเคส</button>
                                                    <% } %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                    <% } %>

                        <!-- New Incident Modal -->
                        <div id="incidentModal" class="modal-overlay">
                            <div class="modal-box">
                                <h3>แจ้งเคส/ปัญหาใหม่</h3>
                                <form action="/periods/<%= period.id %>/incidents" method="POST">
                                    <div class="form-group">
                                        <label>หัวข้อ</label>
                                        <input type="text" name="title" class="form-control" required>
                                    </div>
                                    <div class="form-group">
                                        <label>ความรุนแรง</label>
                                        <select name="severity" class="form-control">
                                            <option value="LOW">LOW (ทั่วไป)</option>
                                            <option value="MED">MED (ปานกลาง)</option>
                                            <option value="HIGH">HIGH (สูง)</option>
                                            <option value="CRITICAL">CRITICAL (วิกฤต - Lock ไม่ได้)</option>
                                        </select>
                                    </div>
                                    <div class="form-group">
                                        <label>รายละเอียด</label>
                                        <textarea name="description" class="form-control" rows="3"></textarea>
                                    </div>
                                    <div class="modal-actions">
                                        <button type="button" class="btn btn-secondary"
                                            onclick="hideModal('incidentModal')">ยกเลิก</button>
                                        <button type="submit" class="btn btn-primary">บันทึก</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Resolve Modal -->
                        <div id="resolveModal" class="modal-overlay">
                            <div class="modal-box">
                                <h3>บันทึกการแก้ไข (Resolution)</h3>
                                <form id="resolveForm" method="POST">
                                    <div class="form-group">
                                        <label>วิธีแก้ไข (Resolution Note)</label>
                                        <textarea name="resolution_note" class="form-control" rows="3" required
                                            placeholder="อธิบายสิ่งที่ทำเพื่อแก้ไขปัญหานี้..."></textarea>
                                    </div>
                                    <div class="modal-actions">
                                        <button type="button" class="btn btn-secondary"
                                            onclick="hideModal('resolveModal')">ยกเลิก</button>
                                        <button type="submit" class="btn btn-success">ปิดเคส</button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <script>
                            function openResolveModal(id) {
                                document.getElementById('resolveForm').action = `/periods/<%= period.id %>/incidents/${id}/resolve`;
                                showModal('resolveModal');
                            }
                        </script>
                        <div class="card mt-20">
                            <div class="card-header">
                                <div class="flex-between">
                                    <h3>ยอดเงินธนาคาร</h3>
                                    <% if (period.status==='OPEN' ) { %>
                                        <a href="/banks/<%= period.id %>" class="btn btn-primary">จัดการยอดเงิน</a>
                                        <% } %>
                                </div>
                            </div>
                            <div class="card-body">
                                <div class="table-container">
                                    <table>
                                        <thead>
                                            <tr>
                                                <th>ธนาคาร</th>
                                                <th>เลขบัญชี</th>
                                                <th>ยอด LAK</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% bankBalances.forEach(bank=> { %>
                                                <tr>
                                                    <td>
                                                        <%= bank.bank_name %>
                                                    </td>
                                                    <td>
                                                        <%= bank.bank_account || '-' %>
                                                    </td>
                                                    <td class="money lak">
                                                        <%= money.format(bank.balance_lak) %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="mt-20">
                                    <strong>รวม LAK:</strong> <span class="money lak">
                                        <%= money.format(bankTotal.total_lak) %>
                                    </span>
                                </div>
                            </div>
                        </div>

                        <!-- Cash Reconciliation -->
                        <div class="card mt-20" style="border: 2px solid #546e7a;">
                            <div class="card-header" style="background-color: #546e7a; color: white;">
                                <h3>💸 กระทบยอดเงินสด (Cash Reconciliation)</h3>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-6">
                                        <h4 style="border-bottom: 2px solid #ddd; padding-bottom: 10px;">ที่มาของเงิน
                                            (System)</h4>
                                        <table class="table table-sm">
                                            <tr style="background-color: #f3e5f5;">
                                                <td style="color: #6a1b9a; font-weight: bold;">1. เงินยกมา (Opening
                                                    Balance)
                                                </td>
                                                <td class="text-end" style="color: #6a1b9a; font-weight: bold;">+<%=
                                                        money.format(parseFloat(summary.opening_balance) || 0) %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>2. ยอดขายสุทธิ (Net Sales)</td>
                                                <td class="text-end text-success">+<%= money.format(gross_sales -
                                                        total_prizes) %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>3. กำไรโยนหวย (Profit Throwing)</td>
                                                <td class="text-end text-success">+<%= money.format(profit_throwing) %>
                                                </td>
                                            </tr>
                                            <tr>
                                                <td>4. เติมเงิน (Inflation)</td>
                                                <td class="text-end text-primary">+<%=
                                                        money.format(parseFloat(summary.capital_injection) || 0) %>
                                                </td>
                                            </tr>
                                            <!-- New Cash-in Rows -->
                                            <% if (summary.pre_draw_cash_in_amount> 0) { %>
                                                <tr>
                                                    <td>ยอดเข้าก่อนหวยออก (งวดถัดไป)</td>
                                                    <td class="text-end text-success">+<%=
                                                            money.format(parseFloat(summary.pre_draw_cash_in_amount) ||
                                                            0) %>
                                                    </td>
                                                </tr>
                                                <% } %>
                                                    <% if (summary.post_draw_cash_in_amount> 0) { %>
                                                        <tr>
                                                            <td>ยอดเข้าหลังหวยออก (งวดที่แล้ว)</td>
                                                            <td class="text-end text-success">+<%=
                                                                    money.format(parseFloat(summary.post_draw_cash_in_amount)
                                                                    || 0) %>
                                                            </td>
                                                        </tr>
                                                        <% } %>

                                                            <% if (summary.late_cash_in_amount> 0) { %>
                                                                <tr>
                                                                    <td>ตกหล่น/ปรับปรุงย้อนหลัง (Late/Adjust)</td>
                                                                    <td class="text-end text-warning">+<%=
                                                                            money.format(parseFloat(summary.late_cash_in_amount)
                                                                            || 0) %>
                                                                    </td>
                                                                </tr>
                                                                <% } %>

                                                                    <tr>
                                                                        <td>5. คืนทุน (Return)</td>
                                                                        <td class="text-end text-danger">-<%=
                                                                                money.format(parseFloat(summary.capital_return)
                                                                                || 0) %>
                                                                        </td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>6. ค่าใช้จ่าย (Expenses)</td>
                                                                        <td class="text-end text-danger">-<%=
                                                                                money.format(expenseTotal.total_lak) %>
                                                                        </td>
                                                                    </tr>
                                                                    <tr
                                                                        style="font-weight: bold; background-color: #eceff1;">
                                                                        <td>ยอดเงินที่ควรมี (Expected)</td>
                                                                        <% const
                                                                            pre_draw=parseFloat(summary.pre_draw_cash_in_amount)
                                                                            || 0; const
                                                                            post_draw=parseFloat(summary.post_draw_cash_in_amount)
                                                                            || 0; const
                                                                            late_in=parseFloat(summary.late_cash_in_amount)
                                                                            || 0; const
                                                                            expected_cash=(parseFloat(summary.opening_balance)
                                                                            || 0) + (gross_sales - total_prizes) +
                                                                            profit_throwing +
                                                                            (parseFloat(summary.capital_injection) || 0)
                                                                            + pre_draw + post_draw + late_in -
                                                                            (parseFloat(summary.capital_return) || 0) -
                                                                            (parseFloat(expenseTotal.total_lak) || 0);
                                                                            %>
                                                                            <td class="text-end"
                                                                                style="color: #546e7a;">
                                                                                <%= money.format(expected_cash) %>
                                                                            </td>
                                                                    </tr>
                                        </table>
                                    </div>
                                    <div class="col-md-6">
                                        <h4 style="border-bottom: 2px solid #ddd; padding-bottom: 10px;">ยอดเงินจริง
                                            (Actual)
                                        </h4>
                                        <div
                                            style="background-color: #f5f5f5; padding: 20px; border-radius: 8px; text-align: center;">
                                            <p class="text-muted">ยอดรวมทุกบัญชี (BCEL One)</p>
                                            <h2 style="color: #2c3e50; font-size: 2.5rem;">
                                                <%= money.format(bankTotal.total_lak) %>
                                            </h2>
                                        </div>

                                        <div style="margin-top: 20px; text-align: center;">
                                            <p class="text-muted">ผลต่าง (Diff)</p>
                                            <% const diff=bankTotal.total_lak - expected_cash; %>
                                                <h2
                                                    style="color: <%= diff == 0 ? '#2ecc71' : (diff > 0 ? '#27ae60' : '#c0392b') %>; font-size: 2rem;">
                                                    <%= diff> 0 ? '+' : '' %><%= money.format(diff) %>
                                                </h2>
                                                <% if (diff !==0) { %>
                                                    <small class="text-danger">
                                                        <%= diff < 0 ? 'เงินขาด (Short)' : 'เงินเกิน (Over)' %>
                                                    </small>
                                                    <% } else { %>
                                                        <small class="text-success">ยอดตรง (Matched)</small>
                                                        <% } %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Quick Expense Modal -->
                        <%- include('../partials/expense_modal') %>

                            <script>
                                // Button to open Quick Expense
                                function showQuickExpense() {
                                    document.getElementById('quickExpenseModal').style.display = 'block';
                                }

                                document.addEventListener('DOMContentLoaded', function () {
                                    // Check for Permalinks (Auto-open Modal)
                                    const urlParams = new URLSearchParams(window.location.search);
                                    if (urlParams.get('action') === 'new_incident') {
                                        showModal('incidentModal');
                                    }
                                });
                            </script>

                            <div class="text-center text-muted" style="margin-top: 50px; font-size: 0.8rem;">
                                Debug Timestamp: <%= new Date().toLocaleTimeString('th-TH') %>
                            </div>