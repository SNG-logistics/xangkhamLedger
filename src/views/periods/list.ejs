<!-- FILE: src/views/periods/list.ejs -->
<div class="period-list-actions">
    <h3>รายการงวดทั้งหมด</h3>
    <button class="btn btn-primary" onclick="showModal('createPeriodModal')">สร้างงวดใหม่</button>
</div>

<div class="card">
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>วันที่งวด</th>
                    <th>ปี</th>
                    <th>เดือน</th>
                    <th>เวลาออก</th>
                    <th>สถานะ</th>
                    <th>LOCK โดย</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% periods.forEach(period=> { %>
                    <tr>
                        <td>
                            <%= new Date(period.period_date).toLocaleDateString('th-TH', { year: 'numeric' ,
                                month: 'long' , day: 'numeric' }) %>
                        </td>
                        <td>
                            <%= period.period_year %>
                        </td>
                        <td>
                            <%= period.period_month %>
                        </td>
                        <td>
                            <%= period.draw_time %>
                        </td>
                        <td>
                            <span
                                class="status-badge <%= period.status === 'LOCKED' ? 'status-locked' : 'status-open' %>">
                                <%= period.status %>
                            </span>
                        </td>
                        <td>
                            <%= period.locked_by_username || '-' %>
                        </td>
                        <td>
                            <a href="/periods/<%= period.id %>" class="btn btn-secondary">ดูรายละเอียด</a>
                        </td>
                    </tr>
                    <% }) %>
            </tbody>
        </table>
    </div>
</div>

<!-- Create Period Modal -->
<div id="createPeriodModal" class="modal-overlay">
    <div class="modal-box">
        <h3>สร้างงวดใหม่</h3>
        <form method="POST" action="/periods/create">
            <div class="form-group">
                <label>วันที่งวด</label>
                <input type="date" name="period_date" class="form-control" required onchange="validateDay(this)">
                <small class="text-muted" style="color: #6c757d; display: block; margin-top: 5px;">* เลือกได้เฉพาะ
                    จันทร์, พุธ, ศุกร์</small>
            </div>
            <script>
                function validateDay(input) {
                    const date = new Date(input.value);
                    const day = date.getDay();
                    if (![1, 3, 5].includes(day)) {
                        alert('เลือกได้เฉพาะวัน จันทร์, พุธ, ศุกร์ เท่านั้น');
                        input.value = '';
                    }
                }
            </script>
    </div>
    <div class="modal-actions">
        <button type="button" class="btn btn-secondary" onclick="hideModal('createPeriodModal')">ยกเลิก</button>
        <button type="submit" class="btn btn-primary">สร้าง</button>
    </div>
    </form>
</div>
</div>