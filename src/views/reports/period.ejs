<!-- FILE: src/views/reports/period.ejs -->
<div class="report-header">
    <div class="report-period">รายงานงวดวันที่ <%= new Date(period.period_date).toLocaleDateString('th-TH', {
            year: 'numeric' , month: 'long' , day: 'numeric' }) %>
    </div>
    <div class="report-date">ปี <%= period.period_year %> / เดือน <%= period.period_month %>
    </div>
</div>

<% const total_prizes=(parseFloat(summary.prize_6_digit) || 0) + (parseFloat(summary.prize_5_digit) || 0) +
    (parseFloat(summary.prize_4_digit) || 0) + (parseFloat(summary.prize_3_digit) || 0) +
    (parseFloat(summary.prize_2_digit) || 0) + (parseFloat(summary.prize_1_digit) || 0); const
    gross_sales=(parseFloat(summary.sales_6_digit) || 0) + (parseFloat(summary.sales_5_digit) || 0) +
    (parseFloat(summary.sales_4_digit) || 0) + (parseFloat(summary.sales_3_digit) || 0) +
    (parseFloat(summary.sales_2_digit) || 0) + (parseFloat(summary.sales_1_digit) || 0); const net_sales=gross_sales -
    total_prizes; const profit_lak=net_sales - (parseFloat(expenseTotal.total_lak) || 0); const profit_thb=0 -
    (parseFloat(expenseTotal.total_thb) || 0); %>

    <!-- Screen Dashboard (Hidden on Print) -->
    <div class="card mb-20 no-print">
        <div class="card-body">
            <div style="display: flex; gap: 15px; justify-content: space-between;">
                <!-- 1. Gross Sales -->
                <div
                    style="flex: 1; padding: 15px; background: #f8f9fa; border-radius: 10px; border-left: 5px solid #3498db;">
                    <h5 style="margin: 0; color: #7f8c8d; font-size: 0.9rem;">ยอดขายรวม (Gross)</h5>
                    <div style="font-size: 1.4rem; font-weight: bold; color: #2c3e50; margin-top: 5px;">
                        <%= money.format(gross_sales) %>
                    </div>
                </div>

                <!-- 2. Prizes -->
                <div
                    style="flex: 1; padding: 15px; background: #fff5f0; border-radius: 10px; border-left: 5px solid #e67e22;">
                    <h5 style="margin: 0; color: #d35400; font-size: 0.9rem;">ยอดถูกรางวัล (Prizes)</h5>
                    <div style="font-size: 1.4rem; font-weight: bold; color: #d35400; margin-top: 5px;">
                        - <%= money.format(total_prizes) %>
                    </div>
                </div>

                <!-- 3. Net Sales -->
                <div
                    style="flex: 1; padding: 15px; background: #e8f8f5; border-radius: 10px; border-left: 5px solid #27ae60;">
                    <h5 style="margin: 0; color: #16a085; font-size: 0.9rem;">ยอดขายสุทธิ (Net Sales)</h5>
                    <div style="font-size: 1.4rem; font-weight: bold; color: #27ae60; margin-top: 5px;">
                        <%= money.format(net_sales) %>
                    </div>
                    <div style="font-size: 0.8rem; color: #27ae60;">(Gross - Prizes)</div>
                </div>

                <!-- 4. Expenses -->
                <div
                    style="flex: 1; padding: 15px; background: #f4f6f7; border-radius: 10px; border-left: 5px solid #7f8c8d;">
                    <h5 style="margin: 0; color: #7f8c8d; font-size: 0.9rem;">ค่าใช้จ่าย (Expenses)</h5>
                    <div style="font-size: 1.4rem; font-weight: bold; color: #2c3e50; margin-top: 5px;">
                        - <%= money.format(expenseTotal.total_lak || 0) %>
                    </div>
                </div>

                <!-- 5. Net Profit -->
                <div
                    style="flex: 1; padding: 15px; background: #eafaf1; border-radius: 10px; border-left: 5px solid #2ecc71; box-shadow: 0 4px 6px rgba(0,0,0,0.05);">
                    <h5 style="margin: 0; color: #27ae60; font-size: 0.9rem;">กำไรสุทธิ (Profit)</h5>
                    <div style="font-size: 1.4rem; font-weight: bold; color: #2ecc71; margin-top: 5px;">
                        <%= money.format(profit_lak) %>
                    </div>
                    <div style="font-size: 0.8rem; color: #27ae60;">(Net Sales - Expenses)</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Print Only Summary Table -->
    <div class="print-only mb-20">
        <h3>สรุปผลประกอบการ (Performance Summary)</h3>
        <table style="width: 100%; border: 1px solid #ddd; margin-bottom: 20px;">
            <thead>
                <tr style="background-color: #2c3e50; color: white;">
                    <th style="padding: 10px;">รายการ</th>
                    <th style="padding: 10px; text-align: right;">จำนวนเงิน (LAK)</th>
                    <th style="padding: 10px; text-align: right;">หมายเหตุ</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td style="padding: 8px;">1. ยอดขายรวม (Gross Sales)</td>
                    <td style="padding: 8px; text-align: right; font-weight: bold; color: #2980b9;">
                        <%= money.format(gross_sales) %>
                    </td>
                    <td></td>
                </tr>
                <tr>
                    <td style="padding: 8px;">2. หัก ยอดถูกรางวัล (Prizes)</td>
                    <td style="padding: 8px; text-align: right; color: #c0392b;">- <%= money.format(total_prizes) %>
                    </td>
                    <td></td>
                </tr>
                <tr style="background-color: #e8f8f5; font-weight: bold;">
                    <td style="padding: 8px;">3. ยอดขายสุทธิ (Net Sales)</td>
                    <td style="padding: 8px; text-align: right; color: #27ae60;">
                        <%= money.format(net_sales) %>
                    </td>
                    <td>(1 - 2)</td>
                </tr>
                <tr>
                    <td style="padding: 8px;">4. หัก ค่าใช้จ่าย (Expenses)</td>
                    <td style="padding: 8px; text-align: right; color: #7f8c8d;">- <%=
                            money.format(expenseTotal.total_lak || 0) %>
                    </td>
                    <td></td>
                </tr>
                <tr style="background-color: #2ecc71; color: white; font-weight: bold; font-size: 1.1em;">
                    <td style="padding: 10px;">5. กำไรสุทธิ (Net Profit)</td>
                    <td style="padding: 10px; text-align: right;">
                        <%= money.format(profit_lak) %>
                    </td>
                    <td>(3 - 4)</td>
                </tr>
                <% if (summary.sales_thb) { %>
                    <tr style="background-color: #fce4ec; color: #c2185b; font-weight: bold;">
                        <td style="padding: 10px;">(Optional) ยอดรวมสุทธิ (THB)</td>
                        <td style="padding: 10px; text-align: right;">
                            <%= money.format(summary.sales_thb) %>
                        </td>
                        <td>ระบุตามจริง</td>
                    </tr>
                    <% } %>
            </tbody>
        </table>
    </div>

    <!-- Detailed Tables Section -->
    <div class="grid-2-col">

        <!-- Expenses Detail -->
        <div class="card">
            <div class="card-header">
                <h3>💰 รายละเอียดค่าใช้จ่าย</h3>
            </div>
            <div class="card-body">


                <div class="table-container mt-20">
                    <table>
                        <thead>
                            <tr>
                                <th style="width: 50px; text-align: center;">ลำดับ</th>
                                <th>เวลาเกิด</th>
                                <th>ประเภท</th>
                                <th>รายละเอียด</th>
                                <th>LAK</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% expenses.forEach((exp, index)=> { %>
                                <tr
                                    style="<%= exp.category === 'จ่ายโปร' ? 'background-color: #ffebee; color: #c62828;' : '' %>">
                                    <td style="text-align: center;">
                                        <%= index + 1 %>
                                    </td>
                                    <td>
                                        <%= new Date(exp.occurred_at).toLocaleString('th-TH', { year: 'numeric' ,
                                            month: 'short' , day: 'numeric' , hour: '2-digit' , minute: '2-digit' }) %>
                                    </td>
                                    <td>
                                        <%= exp.category %>
                                    </td>
                                    <td>
                                        <%= exp.description %>
                                    </td>
                                    <td class="money lak">
                                        <%= money.format(exp.amount_lak) %>
                                    </td>
                                </tr>
                                <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Bank Balances -->
        <div class="card">
            <div class="card-header">
                <h3>🏦 ยอดเงินธนาคาร</h3>
            </div>
            <div class="card-body">
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>ธนาคาร</th>
                                <th>เลขบัญชี</th>
                                <th>ยอด LAK</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% banks.forEach(bank=> { %>
                                <tr>
                                    <td>
                                        <%= bank.bank_name %>
                                    </td>
                                    <td>
                                        <%= bank.bank_account || '-' %>
                                    </td>
                                    <td class="money lak">
                                        <%= money.format(bank.balance_lak) %>
                                    </td>
                                </tr>
                                <% }) %>
                                    <tr style="font-weight: bold; background: #f8f9fa;">
                                        <td colspan="2">รวม</td>
                                        <td class="money lak">
                                            <%= money.format(bankTotal.total_lak) %>
                                        </td>
                                    </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-20 flex gap-10">
            <a href="/periods/<%= period.id %>" class="btn btn-secondary">กลับ</a>
            <button class="btn btn-primary" onclick="window.print()">🖨️ พิมพ์รายงาน</button>
        </div>