<!-- FILE: src/views/banks/form.ejs -->
<div class="card">
    <div class="card-header">
        <h3>จัดการยอดเงินธนาคาร - งวด <%= periodId %>
        </h3>
    </div>
    <div class="card-body">
        <!-- Existing Banks -->
        <% if (banks.length> 0) { %>
            <h4>รายการปัจจุบัน</h4>
            <div class="bank-grid">
                <% banks.forEach(bank=> { %>
                    <div class="card">
                        <div class="flex-between">
                            <h4>
                                <%= bank.bank_name %>
                            </h4>
                            <button class="btn btn-sm btn-danger icon-btn" onclick="deleteBank('<%= bank.id %>')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </div>
                        <p>บัญชี: <%= bank.bank_account || '-' %>
                        </p>
                        <p class="money lak">LAK: <%= bank.balance_lak %>
                        </p>
                    </div>
                    <% }) %>
            </div>
            <hr class="mt-20 mb-20">
            <% } %>

                <!-- Add New Bank -->
                <h4>เพิ่มธนาคารใหม่</h4>
                <form method="POST" action="/banks/create">
                    <input type="hidden" name="period_id" value="<%= periodId %>">

                    <div class="form-group">
                        <label>ธนาคาร (Bank)</label>
                        <select name="bank_name" id="bankSelect" class="form-control" onchange="autoFillAccount()"
                            required>
                            <option value="">-- เลือกธนาคาร --</option>
                            <% if (typeof masterAccounts !=='undefined' ) { %>
                                <% masterAccounts.forEach(acc=> { %>
                                    <option value="<%= acc.bank_name %>" data-account="<%= acc.account_number %>"
                                        data-name="<%= acc.account_name %>">
                                        <%= acc.bank_name %> (<%= acc.account_name %>)
                                    </option>
                                    <% }) %>
                                        <% } else { %>
                                            <option value="BCEL">BCEL</option>
                                            <option value="LDB">LDB</option>
                                            <option value="JDB">JDB</option>
                                            <option value="OTHER">อื่นๆ</option>
                                            <% } %>
                        </select>
                    </div>

                    <div class="form-group">
                        <label>เลขบัญชี (Account Number)</label>
                        <input type="text" name="bank_account" id="bankAccount" class="form-control">
                    </div>

                    <div class="form-group">
                        <label>ยอดเงิน LAK (Amount)</label>
                        <input type="number" step="0.01" name="balance_lak" class="form-control" data-money required>
                    </div>

                    <div class="form-group">
                        <label>หมายเหตุ</label>
                        <textarea name="notes" class="form-control"></textarea>
                    </div>

                    <div class="mt-20 flex gap-10">
                        <button type="submit" class="btn btn-primary">บันทึก</button>
                        <a href="/periods/<%= periodId %>" class="btn btn-secondary">กลับ</a>
                    </div>
                </form>
    </div>
</div>

<!-- Delete Modal -->
<div id="deleteBankModal" class="modal-overlay">
    <div class="modal-box">
        <h3>ยืนยันการลบรายการ</h3>
        <p class="text-danger">ต้องการลบยอดเงินธนาคารนี้หรือไม่?</p>
        <form id="deleteForm">
            <input type="hidden" id="deleteId">
            <div class="form-group">
                <label>เหตุผล (Reason) <span class="text-danger">*</span></label>
                <textarea id="deleteReason" class="form-control" rows="2" required
                    placeholder="ระบุเหตุผล..."></textarea>
            </div>
            <div class="modal-actions">
                <button type="button" class="btn btn-secondary" onclick="hideModal('deleteBankModal')">ยกเลิก</button>
                <button type="submit" class="btn btn-danger">ยืนยันลบ</button>
            </div>
        </form>
    </div>
</div>

<script>
    const currentPeriodId = '<%= periodId %>';

    function autoFillAccount() {
        const select = document.getElementById('bankSelect');
        const option = select.options[select.selectedIndex];
        if (option.dataset.account) {
            document.getElementById('bankAccount').value = option.dataset.account;
        }
    }

    function deleteBank(id) {
        document.getElementById('deleteId').value = id;
        document.getElementById('deleteReason').value = '';
        showModal('deleteBankModal');
    }

    document.getElementById('deleteForm').onsubmit = async (e) => {
        e.preventDefault();
        const id = document.getElementById('deleteId').value;
        const reason = document.getElementById('deleteReason').value;

        try {
            const response = await fetch(`/banks/${id}`, {
                method: 'DELETE',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reason, period_id: currentPeriodId })
            });

            if (response.ok) {
                location.reload();
            } else {
                // Try to parse error message if JSON
                const contentType = response.headers.get("content-type");
                if (contentType && contentType.indexOf("application/json") !== -1) {
                    const result = await response.json();
                    alert(result.error || 'เกิดข้อผิดพลาดในการลบ');
                } else {
                    alert('เกิดข้อผิดพลาด (Server Error)');
                }
            }
        } catch (error) {
            console.error(error);
            alert('Error connecting to server');
        }
    };
</script>
</div>