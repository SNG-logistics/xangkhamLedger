<script>
    let lotteryData = [];
    let uploadedFilesData = { 2: null, 3: null, 4: null, 5: null, 6: null };

    // Tab switcher function
    function switchTab(mode) {
        const tabApiBtn = document.getElementById('tabApiBtn');
        const tabUploadBtn = document.getElementById('tabUploadBtn');
        const apiFetchSection = document.getElementById('apiFetchSection');
        const fileUploadSection = document.getElementById('fileUploadSection');

        if (mode === 'api') {
            tabApiBtn.className = 'btn active-tab-btn rounded-pill px-4 py-2';
            tabUploadBtn.className = 'btn text-secondary rounded-pill px-4 py-2';
            apiFetchSection.style.display = 'block';
            fileUploadSection.style.display = 'none';
        } else {
            tabApiBtn.className = 'btn text-secondary rounded-pill px-4 py-2';
            tabUploadBtn.className = 'btn active-tab-btn rounded-pill px-4 py-2';
            apiFetchSection.style.display = 'none';
            fileUploadSection.style.display = 'block';
        }
    }

    // Sniffer code instructions
    function showSnifferGuide() {
        Swal.fire({
            title: '💡 วิธีการดึงข้อมูลอัตโนมัติ',
            html: `
                <div class="text-start" style="font-size: 0.9rem;">
                    <p class="mb-2">1. เข้าสู่ระบบของ <b>ช้างคำ</b> (<a href="http://128.199.212.93:5001" target="_blank">128.199.212.93:5001</a>)</p>
                    <p class="mb-2">2. กดปุ่ม <b>F12</b> เพื่อเปิด Console ของเบราว์เซอร์</p>
                    <p class="mb-2">3. คัดลอกและวางโค้ดด้านล่างนี้ลงใน Console แล้วกด Enter:</p>
                    <textarea class="form-control mb-3 text-wrap font-monospace select-all" readonly style="font-size: 0.75rem; height: 120px; background: #f8fafc; cursor: pointer;" onclick="this.select()">(() => {
    const originalFetch = window.fetch;
    window.fetch = async function(...args) {
        const [url, options] = args;
        if (typeof url === 'string' && url.includes('api.xangkham.com')) {
            let token = options?.headers?.get?.('Authorization') || options?.headers?.['Authorization'] || options?.headers?.['authorization'];
            let roundNo = new URL(url, window.location.origin).searchParams.get("roundNo");
            if (token && roundNo) {
                const ledgerUrl = "http://localhost:4500/audit/check?token=" + encodeURIComponent(token) + "&roundNo=" + roundNo;
                window.open(ledgerUrl, '_blank');
                window.fetch = originalFetch;
            }
        }
        return originalFetch.apply(this, args);
    };
    alert("🟢 ตัวเชื่อมต่อพร้อม! กรุณากดปุ่ม 'ค้นหา' ในหน้าเว็บเพื่อดึงข้อมูลทันที");
})();</textarea>
                    <p class="mb-0">4. กดปุ่ม <b>"ค้นหา"</b> ในเว็บช้างคำ ระบบจะเปิดหน้าจอนี้พร้อมดึงข้อมูลให้อัตโนมัติทันทีครับ!</p>
                </div>
            `,
            confirmButtonColor: '#4f46e5'
        });
    }

    // Direct fetch from backend proxy
    async function fetchFromApiDirectly(customToken, customRoundNo) {
        const token = customToken || document.getElementById('tokenInput').value.trim();
        const roundNo = customRoundNo || document.getElementById('roundNoInput').value.trim();

        if (!token) {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอก Token', text: 'คัดลอก Token จากระบบช้างคำมาใส่เพื่อดำเนินการดึงข้อมูล', confirmButtonColor: '#4f46e5' });
            return;
        }
        if (!roundNo) {
            Swal.fire({ icon: 'warning', title: 'กรุณากรอกเลขงวด', text: 'กรุณากรอกเลขงวดที่ต้องการตรวจสอบ', confirmButtonColor: '#4f46e5' });
            return;
        }

        const uploadCard = document.getElementById('uploadCard');
        const originalContent = uploadCard.innerHTML;
        
        uploadCard.innerHTML = `
            <div class="card-body p-5 text-center">
                <div class="spinner-border text-primary spinner-border-custom mb-3" role="status">
                    <span class="visually-hidden">กำลังดึงข้อมูล...</span>
                </div>
                <h4 class="text-primary fw-bold">กำลังดึงข้อมูลจากช้างคำ API...</h4>
                <p class="text-muted mt-2 mb-0">ระบบกำลังดึงข้อมูลและดึงทุกหน้าผ่าน backend เพื่อเลี่ยงปัญหา CORS</p>
                <div class="progress mt-4 mx-auto" style="max-width: 400px; height: 10px;">
                    <div class="progress-bar progress-bar-striped progress-bar-animated bg-primary" role="progressbar" style="width: 100%"></div>
                </div>
            </div>
        `;

        try {
            const response = await fetch('/audit/fetch-direct', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ token, roundNo })
            });

            if (!response.ok) {
                const errData = await response.json();
                throw new Error(errData.error || 'ดึงข้อมูลไม่สำเร็จ');
            }

            const data = await response.json();
            if (data.items && data.items.length > 0) {
                lotteryData = data.items;
                document.getElementById('roundLabel').innerText = "งวดประจำวันที่: " + roundNo;
                finishLoad(data.count, data.totalAmount);
            } else {
                throw new Error('ไม่พบข้อมูลหวยในงวดนี้เลย (0 รายการ)');
            }

        } catch (e) {
            // Restore UI
            uploadCard.innerHTML = originalContent;
            switchTab('api');
            
            Swal.fire({
                icon: 'error',
                title: 'เกิดข้อผิดพลาด',
                text: e.message || 'โปรดตรวจสอบสิทธิ์การใช้งาน (Token) อีกครั้ง',
                confirmButtonColor: '#4f46e5'
            });
        }
    }

    // Setup Drag and drop for each slot
    document.addEventListener('DOMContentLoaded', () => {
        [2, 3, 4, 5, 6].forEach(digit => {
            const zone = document.getElementById(`dropZone${digit}`);
            if (!zone) return;
            
            zone.addEventListener('dragover', (e) => {
                e.preventDefault();
                zone.classList.add('active-drag');
            });
            
            zone.addEventListener('dragleave', (e) => {
                e.preventDefault();
                zone.classList.remove('active-drag');
            });
            
            zone.addEventListener('drop', (e) => {
                e.preventDefault();
                zone.classList.remove('active-drag');
                handleSlotFile(digit, e.dataTransfer.files);
            });
        });
    });

    // Helper to parse file
    function parseFileToItems(file, digit) {
        return new Promise((resolve, reject) => {
            const isExcel = file.name.endsWith('.xlsx') || file.name.endsWith('.xls');
            if (isExcel) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        const data = new Uint8Array(e.target.result);
                        const workbook = XLSX.read(data, { type: 'array' });
                        const firstSheetName = workbook.SheetNames[0];
                        const worksheet = workbook.Sheets[firstSheetName];
                        const csvText = XLSX.utils.sheet_to_csv(worksheet);
                        const items = parseCSVTextToItems(csvText, digit);
                        resolve(items);
                    } catch (err) {
                        reject(err);
                    }
                };
                reader.onerror = () => reject(new Error('ไม่สามารถอ่านไฟล์ได้'));
                reader.readAsArrayBuffer(file);
            } else {
                const reader = new FileReader();
                reader.onload = function(e) {
                    try {
                        const items = parseCSVTextToItems(e.target.result, digit);
                        resolve(items);
                    } catch (err) {
                        reject(err);
                    }
                };
                reader.onerror = () => reject(new Error('ไม่สามารถอ่านไฟล์ได้'));
                reader.readAsText(file);
            }
        });
    }

    // Helper to detect column step size dynamically from headers
    function detectStepSize(headerParts) {
        const numKeywords = ["no", "number", "n", "หมายเลข", "เลขดิบ", "เลข"];
        
        let firstNumIdx = -1;
        for (let i = 0; i < headerParts.length; i++) {
            const val = String(headerParts[i]).toLowerCase().trim();
            if (numKeywords.some(kw => val.includes(kw) || val === kw)) {
                firstNumIdx = i;
                break;
            }
        }
        
        if (firstNumIdx === -1) firstNumIdx = 0;
        
        let secondNumIdx = -1;
        for (let i = firstNumIdx + 1; i < headerParts.length; i++) {
            const val = String(headerParts[i]).toLowerCase().trim();
            if (numKeywords.some(kw => val.includes(kw) || val === kw)) {
                secondNumIdx = i;
                break;
            }
        }
        
        if (secondNumIdx !== -1) {
            return secondNumIdx - firstNumIdx;
        }
        
        return headerParts.length >= 3 ? 3 : 2; 
    }

    // Process parsed CSV string into rows supporting horizontally repeating columns
    function parseCSVTextToItems(csvText, digit) {
        const items = [];
        const lines = csvText.split('\n');
        if (lines.length === 0) return items;
        
        // Find the header line
        let headerLine = "";
        let headerLineIdx = -1;
        for (let i = 0; i < lines.length; i++) {
            const line = lines[i].trim();
            if (line && (line.includes("ประเภท") || line.includes("Type") || line.includes("No") || line.includes("หมายเลข"))) {
                headerLine = line;
                headerLineIdx = i;
                break;
            }
        }
        
        // Fallback to first non-empty line
        if (headerLineIdx === -1) {
            for (let i = 0; i < lines.length; i++) {
                if (lines[i].trim()) {
                    headerLine = lines[i].trim();
                    headerLineIdx = i;
                    break;
                }
            }
        }
        
        if (headerLineIdx === -1) return items;
        
        const headerParts = headerLine.split(',');
        const stepSize = detectStepSize(headerParts);
        
        // Parse data rows
        for (let i = headerLineIdx + 1; i < lines.length; i++) {
            const line = lines[i].trim();
            if (!line || line.charCodeAt(0) === 239) continue;
            
            const parts = line.split(',');
            
            for (let c = 0; c < parts.length; c += stepSize) {
                let number = parts[c];
                let amount = parts[c + 1];
                
                if (number && amount) {
                    number = number.replace(/[="']/g, '').trim();
                    const parsedAmount = parseInt(amount.trim()) || 0;
                    
                    if (number && parsedAmount > 0) {
                        let paddedNum = number;
                        while (paddedNum.length < digit) paddedNum = "0" + paddedNum;
                        items.push({ number: paddedNum, amount: parsedAmount });
                    }
                }
            }
        }
        return items;
    }

    // Handle single slot upload
    async function handleSlotFile(digit, files) {
        const file = files[0];
        if (!file) return;

        const label = document.getElementById(`label${digit}`);
        const zone = document.getElementById(`dropZone${digit}`);

        label.innerText = "กำลังวิเคราะห์ไฟล์...";
        label.className = "text-primary small mb-0 text-truncate px-2";

        try {
            const items = await parseFileToItems(file, digit);
            if (items.length === 0) {
                throw new Error('ไม่พบข้อมูลรายการสลากในไฟล์');
            }

            uploadedFilesData[digit] = {
                fileName: file.name,
                items: items,
                amount: items.reduce((sum, item) => sum + item.amount, 0)
            };

            zone.classList.add('file-loaded');
            label.innerText = `${file.name.substring(0, 15)}... (${items.length.toLocaleString()} รายการ)`;
            label.className = "text-success small mb-0 text-truncate px-2 fw-semibold";
            
            const roundMatch = file.name.match(/(\d{5})/);
            if (roundMatch) {
                document.getElementById('roundLabel').innerText = "งวดประจำวันที่: " + roundMatch[1];
            }

            updateProcessButton();
            
        } catch (err) {
            zone.classList.remove('file-loaded');
            label.innerText = "เกิดข้อผิดพลาด: " + err.message;
            label.className = "text-danger small mb-0 text-truncate px-2";
            uploadedFilesData[digit] = null;
            updateProcessButton();
            
            Swal.fire({
                icon: 'error',
                title: 'วิเคราะห์ไฟล์ไม่สำเร็จ',
                text: err.message,
                confirmButtonColor: '#4f46e5'
            });
        }
    }

    // Update process button status
    function updateProcessButton() {
        let activeSlots = 0;
        for (const key in uploadedFilesData) {
            if (uploadedFilesData[key] !== null) activeSlots++;
        }

        document.getElementById('selectedCount').innerText = activeSlots;
        const btn = document.getElementById('btnProcessUploadedFiles');
        if (activeSlots > 0) {
            btn.disabled = false;
            btn.classList.remove('opacity-50');
        } else {
            btn.disabled = true;
            btn.classList.add('opacity-50');
        }
    }

    // Combine all slot items
    function processAllUploadedSlots() {
        lotteryData = [];
        let totalAmount = 0;
        let recordCount = 0;

        for (const digit in uploadedFilesData) {
            const data = uploadedFilesData[digit];
            if (data) {
                lotteryData = lotteryData.concat(data.items);
                totalAmount += data.amount;
                recordCount += data.items.length;
            }
        }

        if (lotteryData.length > 0) {
            finishLoad(recordCount, totalAmount);
        } else {
            Swal.fire({
                icon: 'warning',
                title: 'ไม่มีข้อมูลไฟล์',
                text: 'กรุณาเลือกไฟล์อย่างน้อย 1 ไฟล์ก่อนประมวลผล',
                confirmButtonColor: '#4f46e5'
            });
        }
    }

    function finishLoad(count, amount) {
        const uploadCard = document.getElementById('uploadCard');
        uploadCard.style.opacity = '0';
        setTimeout(() => {
            uploadCard.parentElement.parentElement.style.display = 'none';
            // Also hide tab switcher
            const tabSwitcher = document.querySelector('.btn-group').parentElement;
            if (tabSwitcher) tabSwitcher.style.display = 'none';
            
            fadeIn(document.getElementById('dashboard'));
            fadeIn(document.getElementById('controlPanel'));
            fadeIn(document.getElementById('auditSection'));
        }, 300);

        document.getElementById('totalRecords').innerText = count.toLocaleString();
        document.getElementById('totalAmount').innerText = amount.toLocaleString();
    }

    // Common fade-in helper
    function fadeIn(element) {
        element.style.opacity = 0;
        element.style.display = 'flex';
        if (element.id === 'dashboard') element.classList.add('row');

        let opacity = 0;
        const timer = setInterval(function () {
            if (opacity >= 1) {
                clearInterval(timer);
            }
            element.style.opacity = opacity;
            opacity += 0.1;
        }, 30);
    }

    function checkNumber() {
        const winNum = document.getElementById('searchInput').value.replace(/[^0-9]/g, '');
        const resultArea = document.getElementById('resultArea');

        if (!winNum || winNum.length !== 6) {
            Swal.fire({
                icon: 'warning',
                title: 'ข้อมูลไม่ครบถ้วน',
                text: 'กรุณากรอกเลข 6 หลักให้ครบถ้วน',
                confirmButtonColor: '#4f46e5'
            });
            return;
        }

        resultArea.style.display = 'block';
        let htmlContent = "";
        htmlContent += calculateMainPrizes(winNum);
        htmlContent += calculateFrontPromo(winNum);
        htmlContent += calculateAnagramPromo(winNum);
        resultArea.innerHTML = htmlContent;

        resultArea.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    // --- RENDER FUNCTIONS ---

    function calculateMainPrizes(winNum) {
        let matches = {
            tier6: { count: 0, sale: 0, payout: 0, rate: 400000, label: "6 ตัวตรง (รางวัลที่ 1)" },
            tier5: { count: 0, sale: 0, payout: 0, rate: 40000, label: "5 ตัวท้าย (รางวัลที่ 2)" },
            tier4: { count: 0, sale: 0, payout: 0, rate: 5000, label: "4 ตัวท้าย (รางวัลที่ 3)" },
            tier3: { count: 0, sale: 0, payout: 0, rate: 500, label: "3 ตัวท้าย (รางวัลที่ 4)" },
            tier2: { count: 0, sale: 0, payout: 0, rate: 60, label: "2 ตัวท้าย (รางวัลที่ 5)" },
        };

        const suffix5 = winNum.substring(1);
        const suffix4 = winNum.substring(2);
        const suffix3 = winNum.substring(3);
        const suffix2 = winNum.substring(4);

        for (let item of lotteryData) {
            const ticket = item.number;
            const amount = item.amount;
            const len = ticket.length;

            if (len === 6 && ticket === winNum) { updateMatch(matches.tier6, amount); }
            else if (len === 5 && ticket === suffix5) { updateMatch(matches.tier5, amount); }
            else if (len === 4 && ticket === suffix4) { updateMatch(matches.tier4, amount); }
            else if (len === 3 && ticket === suffix3) { updateMatch(matches.tier3, amount); }
            else if (len === 2 && ticket === suffix2) { updateMatch(matches.tier2, amount); }
        }

        const total = Object.values(matches).reduce((sum, m) => sum + m.payout, 0);

        return `
        <div class="result-card">
            <div class="result-header">
                <div>
                    <h5 class="fw-bold text-dark mb-0">🏆 รางวัลหลัก (Main Prizes)</h5>
                </div>
                <div class="winning-number">${winNum}</div>
            </div>
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">เงื่อนไข</th>
                            <th class="text-end">เลขที่ถูก</th>
                            <th class="text-end">ซื้อ (หน่วย)</th>
                            <th class="text-end pe-4">จ่าย (หน่วย)</th>
                        </tr>
                    </thead>
                    <tbody>
                        ${renderRow(matches.tier6, winNum, true)}
                        ${renderRow(matches.tier5, suffix5, true)}
                        ${renderRow(matches.tier4, suffix4, true)}
                        ${renderRow(matches.tier3, suffix3, true)}
                        ${renderRow(matches.tier2, suffix2, true)}
                        <tr class="total-row">
                            <td colspan="3" class="ps-4 text-end text-secondary">รวมยอดจ่ายรางวัลหลัก</td>
                            <td class="text-end pe-4 text-success fs-5">${total.toLocaleString()}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>`;
    }

    function calculateFrontPromo(winNum) {
        let matches = {
            front5: { count: 0, sale: 0, payout: 0, rate: 5000, label: "โปร 5 ตัวหน้า" },
            front4: { count: 0, sale: 0, payout: 0, rate: 1000, label: "โปร 4 ตัวหน้า" },
            front3: { count: 0, sale: 0, payout: 0, rate: 50, label: "โปร 3 ตัวหน้า" },
            front2: { count: 0, sale: 0, payout: 0, rate: 1, label: "โปร 2 ตัวหน้า" }
        };

        for (let item of lotteryData) {
            if (item.number.length !== 6) continue;
            const t = item.number;
            const a = item.amount;
            if (t.startsWith(winNum.substring(0, 5))) updateMatch(matches.front5, a);
            else if (t.startsWith(winNum.substring(0, 4))) updateMatch(matches.front4, a);
            else if (t.startsWith(winNum.substring(0, 3))) updateMatch(matches.front3, a);
            else if (t.startsWith(winNum.substring(0, 2))) updateMatch(matches.front2, a);
        }

        const total = Object.values(matches).reduce((sum, m) => sum + m.payout, 0);

        return `
        <div class="result-card border-top-purple">
            <div class="result-header">
                <div><h5 class="fw-bold text-primary mb-0">🎁 โปรเลขหน้า (Front Promo)</h5></div>
            </div>
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr><th class="ps-4">เงื่อนไข</th><th class="text-end">เลขหน้า</th><th class="text-end">ซื้อ</th><th class="text-end pe-4">จ่าย</th></tr>
                    </thead>
                    <tbody>
                        ${renderRow(matches.front5, winNum.substring(0, 5) + "x", false)}
                        ${renderRow(matches.front4, winNum.substring(0, 4) + "xx", false)}
                        ${renderRow(matches.front3, winNum.substring(0, 3) + "xxx", false)}
                        ${renderRow(matches.front2, winNum.substring(0, 2) + "xxxx", false)}
                        <tr class="total-row">
                            <td colspan="3" class="ps-4 text-end text-secondary">รวมโปรหน้า</td>
                            <td class="text-end pe-4 text-success fs-5">${total.toLocaleString()}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>`;
    }

    function calculateAnagramPromo(winNum) {
        let matches = {
            len6: { count: 0, sale: 0, payout: 0, rate: 45, label: "สลับ 6 ตัว" },
            len5: { count: 0, sale: 0, payout: 0, rate: 35, label: "สลับ 5 ตัวท้าย" },
            len4: { count: 0, sale: 0, payout: 0, rate: 25, label: "สลับ 4 ตัวท้าย" }
        };
        const s = (str) => str.split('').sort().join('');
        const t6 = s(winNum), t5 = s(winNum.substring(1)), t4 = s(winNum.substring(2));

        for (let item of lotteryData) {
            const len = item.number.length;
            const sorted = s(item.number);
            const a = item.amount;
            if (len === 6 && sorted === t6) updateMatch(matches.len6, a);
            else if (len === 5 && sorted === t5) updateMatch(matches.len5, a);
            else if (len === 4 && sorted === t4) updateMatch(matches.len4, a);
        }

        const total = Object.values(matches).reduce((sum, m) => sum + m.payout, 0);

        return `
        <div class="result-card border-top-pink">
            <div class="result-header">
                <div><h5 class="fw-bold text-danger mb-0">🔀 โปรเลขสลับ (Anagram)</h5></div>
            </div>
            <div class="table-responsive">
                <table class="table table-custom mb-0">
                    <thead>
                        <tr><th class="ps-4">เงื่อนไข</th><th class="text-end">ซื้อ</th><th class="text-end pe-4">จ่าย</th></tr>
                    </thead>
                    <tbody>
                        ${renderRow(matches.len6, null, false)}
                        ${renderRow(matches.len5, null, false)}
                        ${renderRow(matches.len4, null, false)}
                        <tr class="total-row">
                            <td colspan="2" class="ps-4 text-end text-secondary">รวมโปรสลับ</td>
                            <td class="text-end pe-4 text-success fs-5">${total.toLocaleString()}</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>`;
    }

    function updateMatch(match, amount) {
        match.count++;
        match.sale += amount;
        match.payout += (amount * match.rate);
    }

    function renderRow(data, pattern, isMain) {
        const patternCell = pattern ? `<td class="text-end font-monospace text-primary fw-bold">${pattern}</td>` : '';
        const payoutClass = data.payout > 0 ? "amount-badge" : "text-muted";

        if (pattern === null && isMain === false) { // Anagram case
            return `<tr>
                <td class="ps-4">${data.label} <span class="badge bg-light text-secondary ms-2">x${data.rate}</span></td>
                <td class="text-end text-secondary">${data.sale.toLocaleString()}</td>
                <td class="text-end pe-4"><span class="${payoutClass}">${data.payout.toLocaleString()}</span></td>
            </tr>`;
        }

        return `<tr>
            <td class="ps-4">${data.label} <span class="badge bg-light text-secondary ms-2">x${data.rate}</span></td>
            ${patternCell}
            <td class="text-end text-secondary">${data.sale.toLocaleString()}</td>
            <td class="text-end pe-4"><span class="${payoutClass}">${data.payout.toLocaleString()}</span></td>
        </tr>`;
    }

    document.getElementById('searchInput').addEventListener('keypress', (e) => {
        if (e.key === 'Enter') checkNumber();
    });

    // Check for tokens/roundNo on page load
    document.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const token = urlParams.get('token');
        const roundNo = urlParams.get('roundNo');

        if (token && roundNo) {
            document.getElementById('tokenInput').value = token;
            document.getElementById('roundNoInput').value = roundNo;
            document.getElementById('roundLabel').innerText = "งวดประจำวันที่: " + roundNo;
            
            // Auto trigger fetch
            fetchFromApiDirectly(token, roundNo);
        }
    });
</script>