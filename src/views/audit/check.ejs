<div class="row justify-content-center fade-in-up">
    <div class="col-12 col-xl-10">

        <!-- Header Section -->
        <div class="text-center mb-5 mt-4">
            <h1 class="display-4 fw-bold gradient-text mb-2">ระบบตรวจสอบความถูกต้องสลาก</h1>
            <p class="text-secondary fs-5">Audit Trail Verification System</p>
            <div class="currency-badge">
                <i class="fas fa-coins me-2"></i> 1 หน่วย = 1,000 กีบ
            </div>
        </div>

        <!-- Step 1: Upload -->
        <div class="row justify-content-center mb-5">
            <div class="col-md-8">
                <div class="card glass-card border-0 shadow-lg" id="uploadCard">
                    <div class="card-body p-5 text-center">
                        <div class="step-indicator mb-4">STEP 1</div>
                        <h2 class="h3 fw-bold mb-4">นำเข้าฐานข้อมูล</h2>

                        <div id="dropZone" class="upload-zone-premium"
                            onclick="document.getElementById('fileInput').click()">
                            <div class="upload-content">
                                <div class="icon-circle mb-3">
                                    <i class="fas fa-cloud-upload-alt"></i>
                                </div>
                                <h4 class="mb-2">ลากไฟล์ CSV มาวางที่นี่</h4>
                                <p class="text-muted mb-0">หรือคลิกเพื่อเลือกไฟล์จากคอมพิวเตอร์</p>
                                <span class="badge bg-light text-dark mt-3">รองรับ V.8 Big Data</span>
                            </div>
                        </div>
                        <input type="file" id="fileInput" accept=".csv" style="display: none;">
                    </div>
                </div>
            </div>
        </div>

        <!-- Dashboard Stats -->
        <div id="dashboard" class="row g-4 mb-5" style="display: none;">
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon bg-primary-soft">
                        <i class="fas fa-database"></i>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-value" id="totalRecords">0</h3>
                        <p class="stat-label">จำนวนรายการ</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon bg-warning-soft">
                        <i class="fas fa-hand-holding-usd"></i>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-value text-gold" id="totalAmount">0</h3>
                        <p class="stat-label">ยอดขายรวม</p>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="stat-card">
                    <div class="stat-icon bg-success-soft">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-info">
                        <h3 class="stat-value text-success">READY</h3>
                        <p class="stat-label">สถานะระบบ</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Control Panel -->
        <div id="controlPanel" class="d-flex justify-content-between align-items-center mb-4 px-3"
            style="display: none;">
            <div class="round-info">
                <i class="fas fa-calendar-alt text-primary me-2"></i>
                <span id="roundLabel" class="fw-bold text-dark">งวดประจำวันที่: -</span>
            </div>
            <button onclick="location.reload()" class="btn btn-outline-danger btn-sm rounded-pill px-4">
                <i class="fas fa-redo me-1"></i> เริ่มใหม่
            </button>
        </div>

        <!-- Step 2: Verification -->
        <div id="auditSection" style="display: none;">
            <div class="card glass-card border-0 shadow-lg">
                <div class="card-body p-4 p-md-5">
                    <div class="text-center mb-5">
                        <div class="step-indicator mb-3 mx-auto">STEP 2</div>
                        <h2 class="h3 fw-bold">ตรวจสอบผลรางวัล</h2>
                        <p class="text-muted">กรอกเลขรางวัล 6 ตัวเพื่อตรวจสอบยอดจ่ายทั้งหมด</p>
                    </div>

                    <div class="search-container mx-auto mb-5">
                        <div class="input-group input-group-lg shadow-sm">
                            <input type="text" id="searchInput"
                                class="form-control text-center fw-bold text-primary search-input" placeholder="883845"
                                maxlength="6">
                            <button class="btn btn-gradient px-5" onclick="checkNumber()">
                                <i class="fas fa-search me-2"></i> ตรวจสอบ
                            </button>
                        </div>
                    </div>

                    <div id="resultArea" class="result-animate" style="display: none;"></div>
                </div>
            </div>
        </div>

    </div>
</div>

<style>
    :root {
        --primary-gradient: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%);
        --gold-gradient: linear-gradient(135deg, #fbbf24 0%, #d97706 100%);
