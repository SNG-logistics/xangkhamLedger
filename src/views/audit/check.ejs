        vertical-align: middle;
        padding: 1rem 0.75rem;
    }

    .amount-badge {
        background: #fef3c7;
        color: #b45309;
        padding: 0.25rem 0.75rem;
        border-radius: 20px;
        font-weight: 700;
        font-size: 0.9rem;
    }

    .total-row td {
        background: #f8fafc;
        font-weight: 700;
        color: #1e293b;
