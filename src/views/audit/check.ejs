        transition: opacity 0.2s;
    }

    .btn-gradient:hover {
        opacity: 0.9;
        color: white;
    }

    /* Results */
    .result-card {
        background: white;
        border-radius: 16px;
        overflow: hidden;
        margin-bottom: 1.5rem;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
        border: 1px solid #f1f5f9;
        transition: all 0.3s ease;
    }

