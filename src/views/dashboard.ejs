<!-- FILE: src/views/dashboard.ejs -->

<!-- CSS Libraries -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<div class="dashboard-v2">
    <!-- Header Summary (Bento Grid Top) -->
    <div class="stats-grid-v2">
        <div class="stat-card-v2 gradient-primary animate__animated animate__fadeInUp">
            <div class="stat-icon">
                <i class="fas fa-layer-group"></i>
            </div>
            <div class="stat-content">
                <h3>งวดทั้งหมด</h3>
                <div class="value" id="stats-total-periods">
                    <%= stats.totalPeriods %>
                </div>
            </div>
        </div>

        <div class="stat-card-v2 gradient-success animate__animated animate__fadeInUp" style="animation-delay: 0.1s;">
            <div class="stat-icon">
                <i class="fas fa-door-open"></i>
            </div>
            <div class="stat-content">
                <h3>งวดที่เปิดอยู่</h3>
                <div class="value" id="stats-open-periods">
                    <%= stats.openPeriods %>
                </div>
            </div>
        </div>

        <div class="stat-card-v2 gradient-warning animate__animated animate__fadeInUp" style="animation-delay: 0.2s;">
            <div class="stat-icon">
                <i class="fas fa-lock"></i>
            </div>
            <div class="stat-content">
                <h3>งวดที่ LOCK แล้ว</h3>
                <div class="value" id="stats-locked-periods">
                    <%= stats.lockedPeriods %>
                </div>
            </div>
        </div>
    </div>

    <!-- Chart Section -->
    <div class="card mt-20 animate__animated animate__fadeIn">
        <div class="card-header">
            <h3><i class="fas fa-chart-line"></i> แนวโน้มผลกำไร (Net Profit)</h3>
        </div>
        <div class="card-body">
            <div style="height: 300px; position: relative;">
                <canvas id="salesTrendChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Recent Periods Table -->
    <div class="card mt-20 animate__animated animate__fadeIn">
        <div class="card-header">
            <h3><i class="fas fa-history"></i> งวดล่าสุด</h3>
        </div>
        <div class="card-body">
            <div class="table-container">
                <table>
                    <thead>
                        <tr>
                            <th>วันที่งวด</th>
                            <th>ปี/เดือน</th>
                            <th>ยอดสรุป (Net Profit)</th>
                            <th>สถานะ</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% recentPeriods.forEach(period=> { %>
                            <tr>
                                <td>
                                    <%= new Date(period.period_date).toLocaleDateString('th-TH', { year: 'numeric' ,
                                        month: 'long' , day: 'numeric' }) %>
                                </td>
                                <td>
                                    <%= period.period_year %>/<%= period.period_month %>
                                </td>
                                <td>
                                    <% const net_profit=(parseFloat(period.gross_sales) || 0) -
                                        (parseFloat(period.total_prizes) || 0) + (parseFloat(period.profit_throwing) ||
                                        0) - (parseFloat(period.total_expenses) || 0); %>
                                        <span
                                            style="font-weight: bold; color: <%= net_profit >= 0 ? '#2ecc71' : '#e74c3c' %>">
                                            <%= money.format(net_profit) %>
                                        </span>
                                </td>
                                <td>
                                    <span
                                        class="status-badge <%= period.status === 'LOCKED' ? 'status-locked' : 'status-open' %>">
                                        <%= period.status %>
                                    </span>
                                </td>
                                <td>
                                    <a href="/periods/<%= period.id %>" class="btn btn-sm btn-primary">
                                        <i class="fas fa-eye"></i> ดูรายละเอียด
                                    </a>
                                </td>
                            </tr>
                            <% }) %>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="mt-20 text-center">
        <a href="/periods" class="btn btn-outline-primary">จัดการงวดทั้งหมด <i class="fas fa-arrow-right"></i></a>
    </div>
</div>

<!-- Data Injection for Chart -->
<script>
    // Prepare history data for Chart.js
    window.dashboardHistory = <% - JSON.stringify(recentPeriods.map(p => {
        const profit = (parseFloat(p.gross_sales) || 0) - (parseFloat(p.total_prizes) || 0) - (parseFloat(p.total_expenses) || 0);
        return {
            period_date: new Date(p.period_date).toLocaleDateString('th-TH', { day: '2-digit', month: 'short' }),
            net_profit: profit
        };
    }).reverse()) %>;
</script>

<!-- Scripts -->
<script src="/socket.io/socket.io.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="/js/dashboard-v2.js"></script>

<style>
    /* V2 Dashboard Styles (Placeholder - move to app.css later) */
    .dashboard-v2 {
        padding: 20px 0;
    }

    .stats-grid-v2 {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card-v2 {
        background: #fff;
        border-radius: 16px;
        padding: 24px;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
        display: flex;
        align-items: center;
        transition: transform 0.2s, box-shadow 0.2s;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .stat-card-v2:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
    }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-right: 20px;
        background: rgba(255, 255, 255, 0.2);
        color: #fff;
    }

    .stat-content h3 {
        margin: 0;
        font-size: 14px;
        color: #6b7280;
        /* Tailwind gray-500 */
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .stat-content .value {
        font-size: 32px;
        font-weight: 700;
        color: #111827;
        line-height: 1.2;
    }

    /* Gradients */
    .gradient-primary .stat-icon {
        background: linear-gradient(135deg, #4f46e5, #818cf8);
        box-shadow: 0 4px 10px rgba(79, 70, 229, 0.3);
    }

    .gradient-success .stat-icon {
        background: linear-gradient(135deg, #059669, #34d399);
        box-shadow: 0 4px 10px rgba(5, 150, 105, 0.3);
    }

    .gradient-warning .stat-icon {
        background: linear-gradient(135deg, #d97706, #fbbf24);
        box-shadow: 0 4px 10px rgba(217, 119, 6, 0.3);
    }

    .btn-sm {
        padding: 5px 10px;
        font-size: 13px;
    }
</style>