<!-- FILE: src/views/summaries/form.ejs -->
<div class="card">
    <div class="card-header">
        <h3>บันทึกยอดขาย - งวด <%= periodId %>
        </h3>
    </div>
    <div class="card-body">
        <form method="POST" action="/summaries/save" enctype="multipart/form-data">
            <input type="hidden" name="period_id" value="<%= periodId %>">

            <div class="form-group">
                <label>รายละเอียดแยกประเภท (LAK)</label>
                <div class="table-container">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>ประเภท</th>
                                <th>ยอดขาย (LAK)</th>
                                <th>ยอดถูกรางวัล (LAK)</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% const types=[ { id: '6_digit' , label: '6 ตัว' }, { id: '5_digit' , label: '5 ตัว' }, {
                                id: '4_digit' , label: '4 ตัว' }, { id: '3_digit' , label: '3 ตัว' }, { id: '2_digit' ,
                                label: '2 ตัว' }, { id: '1_digit' , label: '1 ตัว' } ]; %>
                                <% types.forEach(type=> { %>
                                    <tr>
                                        <td>
                                            <%= type.label %>
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" name="sales_<%= type.id %>"
                                                class="form-control sales-input"
                                                value="<%= summary['sales_' + type.id] || 0 %>" placeholder="0.00"
                                                oninput="calculateTotal()">
                                        </td>
                                        <td>
                                            <input type="number" step="0.01" name="prize_<%= type.id %>"
                                                class="form-control prize-input"
                                                value="<%= summary['prize_' + type.id] || 0 %>" placeholder="0.00">
                                        </td>
                                    </tr>
                                    <% }); %>
                                        <tr style="background-color: #f8f9fa; font-weight: bold;">
                                            <td>รวมทั้งหมด</td>
                                            <td id="totalSalesDisplay">0.00</td>
                                            <td id="totalPrizeDisplay">0.00</td>
                                        </tr>
                                        <tr style="background-color: #d1e7dd; color: #0f5132; font-weight: bold;">
                                            <td>ยอดสุทธิ (ยอดขาย - รางวัล)</td>
                                            <td colspan="2" class="text-right" id="totalNetDisplay"
                                                style="text-align: right; padding-right: 20px;">0.00</td>
                                        </tr>
                        </tbody>
                    </table>
                </div>
            </div>

            <script>
                function calculateTotal() {
                    let totalSales = 0;
                    document.querySelectorAll('.sales-input').forEach(input => {
                        totalSales += parseFloat(input.value) || 0;
                    });
                    document.getElementById('totalSalesDisplay').innerText = totalSales.toLocaleString('en-US', { minimumFractionDigits: 2 });

                    let totalPrize = 0;
                    document.querySelectorAll('.prize-input').forEach(input => {
                        totalPrize += parseFloat(input.value) || 0;
                    });
                    document.getElementById('totalPrizeDisplay').innerText = totalPrize.toLocaleString('en-US', { minimumFractionDigits: 2 });

                    let totalNet = totalSales - totalPrize;
                    document.getElementById('totalNetDisplay').innerText = totalNet.toLocaleString('en-US', { minimumFractionDigits: 2 });
                }
                // Run on load
                document.addEventListener('DOMContentLoaded', calculateTotal);
            </script>



            <div class="form-group"
                style="background-color: #e3f2fd; padding: 15px; border-radius: 8px; border: 1px solid #90caf9;">
                <label style="color: #1565c0; font-weight: bold;">กำไรจากโยนของ (LAK)</label>
                <input type="number" step="0.01" name="profit_loss_throwing" class="form-control"
                    value="<%= summary.profit_throwing || 0 %>" placeholder="0.00"
                    style="font-size: 1.2rem; font-weight: bold; color: #1565c0;">
                <small class="text-muted">ใส่ยอดกำไรที่ได้จากการโยนของ (ถ้าขาดทุนให้ไปลงในค่าใช้จ่าย)</small>
            </div>

            <div class="row">
                <!-- INFO: Previous Balance Recommendation -->
                <% if (typeof suggestedOpeningBalance !=='undefined' && suggestedOpeningBalance> 0 &&
                    !summary.opening_balance) { %>
                    <div class="col-12 mb-3">
                        <div class="alert alert-info" style="border-left: 5px solid #17a2b8;">
                            <i class="fas fa-history"></i>
                            <strong>แนะนำ:</strong> ยอดเงินคงเหลือจากงวดที่แล้ว (<%= new
                                Date(previousPeriodDate).toLocaleDateString('th-TH') %>)
                                คือ <u>
                                    <%= new Intl.NumberFormat('th-TH', { minimumFractionDigits: 2
                                        }).format(suggestedOpeningBalance) %>
                                </u> กีบ
                                <br>
                                <small>(ระบบดึงมาให้โดยอัตโนมัติ ท่านสามารถแก้ไขได้หากตัวเลขไม่ถูกต้อง)</small>
                        </div>
                    </div>
                    <% } %>
            </div>

            <div class="form-group"
                style="background-color: #f3e5f5; padding: 15px; border-radius: 8px; border: 1px solid #e1bee7; margin-bottom: 2rem;">
                <label style="color: #6a1b9a; font-weight: bold;">เงินยกมา (Opening Balance) (LAK)</label>
                <input type="number" step="0.01" name="opening_balance" class="form-control"
                    value="<%= summary.opening_balance || suggestedOpeningBalance || 0 %>" placeholder="0.00"
                    style="font-size: 1.2rem; font-weight: bold; color: #6a1b9a;">
                <small class="text-muted">ใส่ยอดเงินคงเหลือในบัญชีธนาคาร ณ ต้นงวด (ก่อนเริ่มขาย)</small>
            </div>

            <!-- NEW: API Cash-in Classification (Additive) -->
            <div class="card mb-4" style="border: 1px solid #dee2e6;">
                <div class="card-header bg-light" id="headingApiCashIn" style="cursor: pointer;"
                    data-bs-toggle="collapse" data-bs-target="#collapseApiCashIn">
                    <h5 class="mb-0" style="font-size: 1rem; color: #495057;">
                        <i class="fas fa-random"></i> (ใหม่) แยกเงินเข้า API (แนบหลักฐานได้)
                        <i class="fas fa-chevron-down float-end"></i>
                    </h5>
                </div>
                <div id="collapseApiCashIn" class="collapse">
                    <div class="card-body">
                        <div class="alert alert-warning">
                            <i class="fas fa-info-circle"></i>
                            <strong>คำชี้แจง:</strong> ช่องนี้เป็นเพียงการ <u>บันทึกแยกประเภท</u> เพื่อแนบหลักฐาน
                            ส่วนยอดเงินรวมให้ท่านยังคงบันทึกในช่อง <b>เติมเงิน (Injection)</b> หรือ <b>ยอดขาย</b>
                            ตามปกติ
                            (Logic ระบบเดิมไม่เปลี่ยน)
                        </div>
                        <div class="row">
                            <div class="col-md-6 border-end">
                                <h6 class="text-primary font-weight-bold">1. รับเข้าก่อนหวยออก (งวดถัดไป)</h6>
                                <p class="text-muted small">
                                    <i class="fas fa-clock"></i> ก่อน 20:10 (ขายล่วงหน้า)
                                </p>
                                <div class="form-group">
                                    <label>จำนวนเงิน (LAK)</label>
                                    <input type="number" step="0.01" name="pre_draw_cash_in_amount" class="form-control"
                                        value="<%= summary.pre_draw_cash_in_amount || 0 %>" placeholder="0.00">
                                </div>
                                <div class="form-group">
                                    <label>แนบหลักฐาน (สลิปโอน)</label>
                                    <input type="file" name="pre_draw_evidence" class="form-control" multiple>
                                </div>
                                <div class="form-group">
                                    <label>หมายเหตุ</label>
                                    <input type="text" name="pre_draw_note" class="form-control"
                                        value="<%= summary.pre_draw_note || '' %>">
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6 class="text-success font-weight-bold">2. รับเข้าหลังหวยออก (งวดที่แล้ว)</h6>
                                <p class="text-muted small">
                                    <i class="fas fa-clock"></i> หลัง 20:10 หรือ T+1
                                </p>
                                <div class="form-group">
                                    <label>จำนวนเงิน (LAK)</label>
                                    <input type="number" step="0.01" name="post_draw_cash_in_amount"
                                        class="form-control" value="<%= summary.post_draw_cash_in_amount || 0 %>"
                                        placeholder="0.00">
                                </div>
                                <div class="form-group">
                                    <label>แนบหลักฐาน (สลิปโอน)</label>
                                    <input type="file" name="post_draw_evidence" class="form-control" multiple>
                                </div>
                                <div class="form-group">
                                    <label>หมายเหตุ</label>
                                    <input type="text" name="post_draw_note" class="form-control"
                                        value="<%= summary.post_draw_note || '' %>">
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="form-group"
                    style="background-color: #fff3cd; padding: 15px; border-radius: 8px; border: 1px solid #ffeeba;">
                    <label style="color: #856404; font-weight: bold;">เติมเงิน (Injection) (LAK)</label>
                    <input type="number" step="0.01" name="capital_injection" class="form-control"
                        value="<%= summary.capital_injection || 0 %>" placeholder="0.00"
                        style="font-size: 1.2rem; font-weight: bold; color: #856404;">
                    <small class="text-muted">ยอดเงินโอนเข้า/เติม เพื่อจ่ายถูกรางวัลหรือสำรองจ่าย</small>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group"
                    style="background-color: #d4edda; padding: 15px; border-radius: 8px; border: 1px solid #c3e6cb;">
                    <label style="color: #155724; font-weight: bold;">คืนทุน/ถอนกำไร (Return) (LAK)</label>
                    <input type="number" step="0.01" name="capital_return" class="form-control"
                        value="<%= summary.capital_return || 0 %>" placeholder="0.00"
                        style="font-size: 1.2rem; font-weight: bold; color: #155724;">
                    <small class="text-muted">ยอดเงินที่โอนออก/ดึงทุนคืนจากระบบ</small>
                </div>
            </div>
    </div>

    <div class="form-group">
        <label>ยอดรวมสุทธิ (THB)</label>
        <input type="number" step="0.01" name="sales_thb" class="form-control" value="<%= summary.sales_thb || 0 %>"
            placeholder="0.00">
        <small class="text-muted">กรอกเฉพาะยอดสุทธิสุดท้าย (ถ้ามี)</small>
    </div>

    <div class="form-group">
        <label>แนบไฟล์ (Excel/PDF/รูป)</label>
        <input type="file" name="attachments" class="form-control" multiple>
    </div>

    <div class="form-group">
        <label>หมายเหตุ</label>
        <textarea name="notes" class="form-control"><%= summary.notes || '' %></textarea>
    </div>

    <div class="mt-20 flex gap-10">
        <button type="submit" class="btn btn-primary">บันทึก</button>
        <a href="/periods/<%= periodId %>" class="btn btn-secondary">ยกเลิก</a>
    </div>
    </form>
</div>
</div>