<!DOCTYPE html>
<html lang="th">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>XANGKHAM Ledger - Login</title>
    <link rel="stylesheet" href="/css/layout.css">
    <link rel="stylesheet" href="/css/components.css">
    <link rel="stylesheet" href="/css/app.css">
    <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        body {
            font-family: 'Sarabun', sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            /* Premium Dark Blue */
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .login-card {
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            padding: 40px;
            width: 100%;
            max-width: 420px;
            position: relative;
            overflow: hidden;
        }

        .login-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 5px;
            background: linear-gradient(90deg, #3498db, #9b59b6);
            /* Brand gradient */
        }

        .brand-header {
            text-align: center;
            margin-bottom: 35px;
        }

        .brand-header h1 {
            font-size: 2rem;
            font-weight: 700;
            color: #1e293b;
            margin: 0 0 5px 0;
            letter-spacing: -0.5px;
        }

        .brand-header p {
            color: #64748b;
            font-size: 0.95rem;
            margin: 0;
        }

        .form-group {
            margin-bottom: 25px;
        }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            color: #475569;
            font-weight: 500;
            font-size: 0.9rem;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px;
            border: 2px solid #e2e8f0;
            border-radius: 8px;
            font-size: 1rem;
            transition: all 0.3s ease;
            color: #1e293b;
            box-sizing: border-box;
            /* Fix padding issue */
        }

        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 3px rgba(52, 152, 219, 0.1);
            outline: none;
        }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: linear-gradient(135deg, #1e293b 0%, #334155 100%);
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(30, 41, 59, 0.3);
        }

        .alert {
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 0.9rem;
            margin-bottom: 25px;
            display: flex;
            align-items: center;
        }

        .alert-danger {
            background-color: #fef2f2;
            color: #ef4444;
            border: 1px solid #fee2e2;
        }

        .footer-text {
            text-align: center;
            margin-top: 25px;
            font-size: 0.85rem;
            color: #94a3b8;
        }
    </style>
</head>

<body>

    <div class="login-card">
        <div class="brand-header">
            <h1>XANGKHAM Ledger</h1>
            <p>ระบบบัญชีสำหรับธุรกิจขายหวย</p>
        </div>

        <% if (error) { %>
            <div class="alert alert-danger">
                ⚠️ <%= error %>
            </div>
            <% } %>

                <form method="POST" action="/login">
                    <div class="form-group">
                        <label for="username">ชื่อผู้ใช้งาน (Username)</label>
                        <input type="text" id="username" name="username" class="form-control"
                            placeholder="ระบุ username" required autofocus>
                    </div>

                    <div class="form-group">
                        <label for="password">รหัสผ่าน (Password)</label>
                        <input type="password" id="password" name="password" class="form-control"
                            placeholder="ระบุ password" required>
                    </div>

                    <button type="submit" class="btn-login">เข้าสู่ระบบ</button>
                </form>

                <div class="footer-text">
                    &copy; 2025 XANGKHAM Ledger. All rights reserved.
                </div>
    </div>

</body>

</html>